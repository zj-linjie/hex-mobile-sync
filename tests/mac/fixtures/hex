#!/bin/bash
# Stub of the hex CLI for tests/mac/test-sync.sh. Synthetic data only.
#
# Environment:
#   STUB_HEX_STATE   directory holding the stub state (copied fixtures, call log)
#   STUB_HEX_MODE    running (default) | stopped (every command exits 3)
#                    | stop-on-add (vocabulary add exits 3)
#   STUB_HEX_ADD_FAIL     term for which `vocabulary add` exits 1
#   STUB_HEX_APPEND_PENDING  pending file to which the first `vocabulary add`
#                    appends a new entry (simulates the iPhone writing meanwhile)
#   STUB_HEX_MERGE_PENDING   pending file in which the first `vocabulary add`
#                    adds a spelling to the entry with id "m1" (iPhone merge)
#   STUB_HEX_SLEEP   seconds every command sleeps first (timeout tests)
#   STUB_HEX_TRANSFER_RC     import exit status (default 0)
#   STUB_HEX_TRANSFER_REPLY  import JSON reply (default imported true)
#   STUB_HEX_VERSION_FAIL    set to fail --version
set -euo pipefail

state="${STUB_HEX_STATE:?STUB_HEX_STATE not set}"
mode="${STUB_HEX_MODE:-running}"
printf '%s\n' "$*" >>"$state/calls.log"

if [ "${1:-}" = "--version" ]; then
    [ "${STUB_HEX_VERSION_FAIL:-0}" = "1" ] && exit 1
    echo "hex 9.8.7"
    exit 0
fi

not_running() {
    cat "$state/not-running.json"
    exit 3
}

[ -n "${STUB_HEX_SLEEP:-}" ] && sleep "$STUB_HEX_SLEEP"

[ "$mode" = "stopped" ] && not_running

case "${1:-} ${2:-}" in
    "transfers import")
        [ "$#" -eq 5 ] && [ "$3" = "--dir" ] && [ "$5" = "--json" ] || exit 2
        case "$4" in /*) ;; *) exit 2 ;; esac
        # Prove a receipt was not written before the importer completed.
        [ ! -e "$4/receipt.json" ] || exit 1
        reply='{"imported":true}'
        printf '%s\n' "${STUB_HEX_TRANSFER_REPLY:-$reply}"
        if [ "${STUB_HEX_TRANSFER_RC:-0}" -ne 0 ]; then
            printf 'PRIVATE-TRANSFER-CLI-ERROR\n' >&2
        fi
        exit "${STUB_HEX_TRANSFER_RC:-0}"
        ;;
    "vocabulary list")
        cat "$state/vocabulary-list.json"
        ;;
    "settings get")
        case "${3:-}" in
            dictation_processing) cat "$state/settings-dictation-processing.json" ;;
            transcription) cat "$state/settings-transcription.json" ;;
            *) echo '{"version":4,"status":"error","code":"unknown-setting"}'; exit 1 ;;
        esac
        ;;
    "vocabulary add")
        [ "$mode" = "stop-on-add" ] && not_running
        shift 2
        spellings=""
        term=""
        while [ "$#" -gt 0 ]; do
            case "$1" in
                --sounds-like=*) spellings="${1#--sounds-like=}"; shift ;;
                --sounds-like)
                    # Like the real parser: a separate value starting with "-"
                    # is read as an unknown option.
                    case "${2:-}" in
                        -*) echo "error: unexpected argument '${2%% *}' found" >&2; exit 2 ;;
                    esac
                    spellings="$2"; shift 2 ;;
                --json) shift ;;
                --) term="$2"; shift 2 ;;
                *) term="$1"; shift ;;
            esac
        done
        if [ -n "${STUB_HEX_ADD_FAIL:-}" ] && [ "$term" = "$STUB_HEX_ADD_FAIL" ]; then
            echo "error: refused" >&2
            exit 1
        fi
        jq --arg t "$term" --arg s "$spellings" '
            ($s | split(",") | map(select(. != ""))) as $new
            | if any(.entries[]; .term == $t)
              then .entries |= map(if .term == $t then .sounds_like += $new else . end)
              else .entries += [{term: $t, sounds_like: $new}] end' \
            "$state/vocabulary-list.json" >"$state/vocabulary-list.next"
        mv "$state/vocabulary-list.next" "$state/vocabulary-list.json"
        if [ -n "${STUB_HEX_APPEND_PENDING:-}" ] && [ ! -f "$state/appended" ]; then
            jq '.entries += [{id: "late-entry", term: "Late Term", sounds_like: [], created_at: "2026-01-01T00:00:00Z"}]' \
                "$STUB_HEX_APPEND_PENDING" >"$state/pending.next"
            mv "$state/pending.next" "$STUB_HEX_APPEND_PENDING"
            touch "$state/appended"
        fi
        if [ -n "${STUB_HEX_MERGE_PENDING:-}" ] && [ ! -f "$state/merged" ]; then
            jq '.entries |= map(if .id == "m1" then .sounds_like += ["new spelling"] else . end)' \
                "$STUB_HEX_MERGE_PENDING" >"$state/pending.next"
            mv "$state/pending.next" "$STUB_HEX_MERGE_PENDING"
            touch "$state/merged"
        fi
        echo "added $term"
        ;;
    *)
        echo "stub: unsupported command: $*" >&2
        exit 2
        ;;
esac
