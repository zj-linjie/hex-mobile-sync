    "No hex-mobile-sync.json in this folder yet. Run the Mac sync script, then refresh.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In questa cartella non c'è ancora hex-mobile-sync.json. Esegui lo script di sincronizzazione sul Mac, poi aggiorna."
          }
