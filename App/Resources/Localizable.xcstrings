    "No iCloud permission is needed: the app only accesses the folder you pick.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non serve alcun permesso iCloud: l'app accede solo alla cartella che scegli."
          }
        }
